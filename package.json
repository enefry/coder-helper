{
  "name": "coder-helper",
  "displayName": "Coder Helper",
  "description": "Escape/unescape code, split URL queries, and format curl commands.",
  "publisher": "renweichen",
  "version": "0.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/enefry/coder-helper.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:coder-helper.curlCommandSplite",
    "onCommand:coder-helper.codeEscape",
    "onCommand:coder-helper.codeUnescape",
    "onCommand:coder-helper.urlQuerySplite",
    "onCommand:coder-helper.urlQueryMerge",
    "onCommand:coder-helper.unicodeUnescape"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      { "command": "coder-helper.curlCommandSplite", "title": "CURL Command Formatter" },
      { "command": "coder-helper.codeEscape", "title": "Code: Escape" },
      { "command": "coder-helper.codeUnescape", "title": "Code: Unescape" },
      { "command": "coder-helper.urlQuerySplite", "title": "URL Query: Split" },
      { "command": "coder-helper.urlQueryMerge", "title": "URL Query: Merge" },
      { "command": "coder-helper.unicodeUnescape", "title": "Code: Unicode Unescape" }
    ]
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "package": "vsce package",
    "publish": "vsce publish",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.125.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.2",
    "assert": "^2.1.0",
    "eslint": "^10.8.0",
    "mocha": "^12.0.3",
    "process": "^0.11.10",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "shell-quote": "^1.12.0"
  }
}
